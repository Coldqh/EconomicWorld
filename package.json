{
  "name": "economic-world",
  "version": "0.17.0",
  "private": true,
  "description": "Детерминированная экономическая симуляция с двойной бухгалтерией",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/simulation.test.ts",
    "test:patch-16-6": "node --experimental-strip-types --test tests/patch-16-5.test.ts tests/patch-16-6.test.ts tests/patch-16-6-completion.test.ts tests/patch-16-6-integrity.test.ts tests/patch-16-6-performance.test.ts",
    "test:phase-17": "node --experimental-strip-types --test tests/phase-17.test.ts",
    "benchmark:phase-17": "node --expose-gc --experimental-strip-types tests/phase-17-benchmark.ts",
    "benchmark:patch-16-6": "node --expose-gc --experimental-strip-types tests/patch-16-6-benchmark.ts",
    "benchmark:20y": "node --experimental-strip-types tests/long-run-benchmark.ts",
    "benchmark:reconciliation": "node --experimental-strip-types tests/reconciliation-benchmark.ts",
    "lint": "eslint src tests vite.config.ts",
    "test:integrity": "node --experimental-strip-types --test tests/patch-16-6-integrity.test.ts",
    "audit:patch-16-6": "node --experimental-strip-types tests/patch-16-6-final-audit.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
